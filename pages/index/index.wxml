<view class="page">
  <view class="nav" style="padding-top:{{statusBar}}px"><view class="nav-title">C++ 刷题</view><view class="nav-act" bindtap="goBank">题库</view></view>
  <view class="campus-intro"><view class="campus-title serif">每天刷一点，C++ 熟一点。</view><view class="campus-desc">从基础开始，做完一道，弄懂一道。</view></view>
  <view class="hero simple-home-card">
    <view class="hero-t serif">{{dailyResume ? '接着上次继续' : '今天刷 20 题'}}</view>
    <view class="hero-d">{{dailyCourse}} · {{dailyResume ? '已保留答案和进度' : '优先练没做过的题'}}</view>
    <button class="btn daily-button" bindtap="goDaily">{{dailyResume ? '继续上次 · 第 ' + dailyIndex + ' 题' : '开始刷题'}}</button>
    <view class="difficulty-link" bindtap="goLearn">按章节练习 / 调整难度 →</view>
  </view>
  <view class="strip">
    <view class="st"><view class="st-n serif">{{answered}}</view><view class="st-l">已练题目</view></view><view class="st-line"></view>
    <view class="st"><view class="st-n serif">{{accuracy}}<text class="st-u">%</text></view><view class="st-l">正确率</view></view><view class="st-line"></view>
    <view class="st"><view class="st-n serif">{{total}}</view><view class="st-l">题库总数</view></view>
  </view>
  <view class="sec"><text class="t">复习巩固</text></view>
  <view class="grid">
    <view class="tile" bindtap="goWrong"><view class="tile-l">错题本</view><view class="tile-d">{{wrongNum}} 题待复习 →</view></view>
    <view class="tile" bindtap="goSaved"><view class="tile-l">我的收藏</view><view class="tile-d">{{favNum}} 题 →</view></view>
  </view>
  <view class="simple-tools"><text bindtap="goBooks">C++ 书单</text><text bindtap="goImport">导入题目</text></view>
  <view class="foot">按自己的节奏来，先理解，再往前。</view>
  <!-- 开始练习：选题数 / 继续上次 -->
  <view class="mask" wx:if="{{picker.open}}" bindtap="closePicker">
    <view class="sheet" catchtap="noop">
      <view class="sh-handle"></view>

      <view class="pk-t">{{picker.name}}</view>
      <view class="pk-s" wx:if="{{picker.canResume}}">上次停在第 {{picker.resumeIdx}} / {{picker.resumeTotal}} 题，接着刷还是重开？</view>
      <view class="pk-s" wx:else>这一轮刷多少题？</view>

      <view class="pk-row">
        <view class="pk-c {{picker.count === item ? 'on' : ''}}"
              wx:for="{{countOpts}}"
              wx:key="*this"
              data-n="{{item}}"
              bindtap="pickCount">{{item === 0 ? '全部' : item + ' 题'}}</view>
      </view>

      <view class="btn {{picker.canResume ? '' : 'pk-go'}}" wx:if="{{picker.canResume}}" bindtap="resumeLast">继续上次 · 第 {{picker.resumeIdx}} 题</view>
      <view class="btn {{picker.canResume ? 'btn-ghost' : 'pk-go'}}" bindtap="startPractice">{{picker.cta}}</view>
    </view>
  </view>

</view>
