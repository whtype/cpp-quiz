/* 结果页 */

.rs {
  padding: 40rpx 4rpx 0;
}

.rs-n {
  display: flex;
  align-items: flex-end;
  margin-top: 8rpx;
}

.rs-n .serif {
  font-size: 168rpx;
  line-height: 0.94;
  letter-spacing: -6rpx;
  color: var(--ink);
}

.rs-u {
  font-size: 30rpx;
  color: var(--ink-3);
  margin: 0 0 16rpx 12rpx;
  letter-spacing: 1rpx;
}

.rs-c {
  margin-top: 18rpx;
  font-size: 27rpx;
  color: var(--ink-2);
  letter-spacing: 0.5rpx;
}

.rs-row {
  display: flex;
  align-items: center;
  margin-top: 44rpx;
  padding: 30rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
}

.rs-i {
  flex: 1;
  text-align: center;
}

.rs-i .serif {
  font-size: 34rpx;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}

.rs-l {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

.rs-line {
  width: 1rpx;
  height: 44rpx;
  background: var(--line);
}

/* 逐题 */
.items {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 4rpx rgba(27, 25, 23, 0.03), 0 16rpx 40rpx -28rpx rgba(27, 25, 23, 0.18);
}

.it {
  padding: 28rpx 30rpx;
  position: relative;
}

.it + .it::before {
  content: '';
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  top: 0;
  height: 1rpx;
  background: var(--line-2);
}

.it-head {
  display: flex;
  align-items: baseline;
}

.it-no {
  width: 52rpx;
  flex-shrink: 0;
  font-size: 28rpx;
}

.it-q {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.it.open .it-q {
  -webkit-line-clamp: 20;
}

.it-mark {
  width: 40rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 24rpx;
}

.it-body {
  padding: 10rpx 0 6rpx 52rpx;
}

.it-l {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}

.it-l .k {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 23rpx;
  color: var(--ink-3);
}

.it-l .v {
  font-size: 27rpx;
  letter-spacing: 1rpx;
}

.it-exp {
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.85;
  color: var(--ink-2);
}

.it-body .code { margin-top: 18rpx; }

/* 底部按钮 */
.btns {
  display: flex;
  margin-top: 44rpx;
}

.btns .btn { flex: 1; }
.btns .btn + .btn { margin-left: 16rpx; }
