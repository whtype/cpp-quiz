/* 书架 */

.head { padding: 24rpx 4rpx 0; }
.head .h1 { margin-top: 16rpx; font-size: 60rpx; }

.head-d {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-3);
  max-width: 560rpx;
}

.shelf { margin-top: 8rpx; }

/* 书卡 */
.bk {
  display: flex;
  background: #fff;
  border-radius: 8rpx 24rpx 24rpx 8rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 3rpx rgba(27, 25, 23, 0.04), 0 16rpx 34rpx -28rpx rgba(27, 25, 23, 0.4);
}

.bk:active { transform: scale(0.995); }

/* 书脊 */
.bk-spine {
  width: 8rpx;
  flex-shrink: 0;
  background: var(--ink-4);
  opacity: 0.55;
}

.bk.free .bk-spine {
  background: var(--accent);
  opacity: 0.9;
}

.bk-body {
  flex: 1;
  min-width: 0;
  padding: 32rpx 32rpx 28rpx 30rpx;
}

.bk-t {
  font-family: Georgia, "Songti SC", serif;
  font-size: 38rpx;
  line-height: 1.3;
  letter-spacing: 0.5rpx;
  color: var(--ink);
}

.bk-en {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--ink-4);
  font-style: italic;
}

.bk-meta {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 0.5rpx;
}

.bk-meta .dot { margin: 0 8rpx; }

.bk-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--ink-2);
}

/* 为什么读 */
.bk-why {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background: var(--paper);
  border-radius: 10rpx;
}

.why-k {
  display: block;
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: var(--ink-4);
}

.why-v {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

.bk-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line-2);
}

.lic {
  flex: 1;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--ink-4);
  padding-right: 16rpx;
}

.act {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--accent);
  letter-spacing: 1rpx;
}

.act.gray { color: var(--ink-3); }

.note {
  margin-top: 40rpx;
  padding: 0 4rpx;
  font-size: 21rpx;
  line-height: 1.85;
  color: var(--ink-4);
}

/* 顶部提示：怎么才能看 */
.hint {
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-left: 3rpx solid var(--accent);
  border-radius: 4rpx;
}

.hint-t {
  font-size: 22rpx;
  line-height: 1.85;
  color: var(--ink-2);
}

.hint-x {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--accent);
  letter-spacing: 1rpx;
}

.pb { height: 40rpx; }
